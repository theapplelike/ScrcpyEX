<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!--菜单栏的按钮样式-->
    <Style x:Key="MenuBtn" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <!--字体资源的生成操作可以是Resource或内容，如果没有生效清理一下项目-->
        <Setter Property="FontFamily" Value="/ScrcpyEX;component/Resource/IconFont/SegoeFluentIcons.ttf#Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>

        <!--重写按钮的模板-->
        <Setter Property="Template">
            <Setter.Value>
                <!--使用按钮原来的样式，不做更改-->
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    
                    <ControlTemplate.Triggers>
                        <!--鼠标悬停时修改背景颜色，这里不需要设置BorderBrush为Transparent，因为已经移除了焦点视觉样式-->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="LightBlue"/>
                        </Trigger>
                        <!--鼠标按下时的样式-->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="SkyBlue"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!--鼠标禁用时的样式-->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#EEEEEE"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--用于设置界面的大按钮-->
    <Style x:Key="BigBtn" TargetType="Button">
        <!--<Setter Property="Width" Value="50"/>-->
        <Setter Property="Height" Value="50"/>
        <Setter Property="FontFamily" Value="幼圆"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="WhiteSmoke"/>
        <Setter Property="BorderBrush" Value="Gainsboro"/>
        <Setter Property="Margin" Value="0,0,0,0"/>

        <!---重写按钮的模板-->
        <Setter Property="Template">
            <Setter.Value>
                <!--使用按钮原来的样式，不做更改-->
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6,6,0,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- 禁用焦点视觉样式 -->
                    <ControlTemplate.Triggers>
                        <!--鼠标悬停时修改背景颜色，这里不需要设置BorderBrush为Transparent，因为已经移除了焦点视觉样式-->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EEEEEE"/>
                        </Trigger>
                        <!--鼠标按下时的样式-->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="#696969"/>
                        </Trigger>
                        <!--鼠标禁用时的样式-->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#EEEEEE"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="txtIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="/ScrcpyEX;component/Resource/IconFont/SegoeFluentIcons.ttf#Segoe Fluent Icons"/>
    </Style>

    <!--用于截图菜单的白色按钮-->
    <Style x:Key="WhiteBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="/ScrcpyEX;component/Resource/IconFont/SegoeFluentIcons.ttf#Segoe Fluent Icons"/>
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="GhostWhite"/>
        <Setter Property="BorderBrush" Value="GhostWhite"/>
        <Setter Property="Margin" Value="0,1"/>

        <!---重写按钮的模板-->
        <Setter Property="Template">
            <Setter.Value>
                <!--使用按钮原来的样式，不做更改-->
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="2"
                            CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- 禁用焦点视觉样式 -->
                    <ControlTemplate.Triggers>
                        <!--鼠标悬停时修改背景颜色，这里不需要设置BorderBrush为Transparent，因为已经移除了焦点视觉样式-->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="LightBlue"/>
                        </Trigger>
                        <!--鼠标按下时的样式-->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="SkyBlue"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!--鼠标禁用时的样式-->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#EEEEEE"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>