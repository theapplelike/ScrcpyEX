<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="MenuBtn" TargetType="Button">
        <Setter Property="Width" Value="50"/>
        <!--<Setter Property="FontFamily" Value="幼圆"/>-->
        <!--字体资源的生成操作可以是Resource或内容，如果没有生效清理一下项目-->
        <Setter Property="FontFamily" Value="/ScrcpyEX;component/Resource/IconFont/SegoeFluentIcons.ttf#Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Margin" Value="0,1,0,0"/>

        <!--隐藏鼠标悬停在按钮上显示的蓝色边框-->
        <Setter Property="Template">
            <Setter.Value>
                <!--使用按钮原来的样式，不做更改-->
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <!-- 禁用焦点视觉样式 -->
                    <ControlTemplate.Triggers>
                        <!--鼠标悬停时只显示背景颜色，这里不需要设置BorderBrush为Transparent，因为已经移除了焦点视觉样式-->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="LightBlue"/>
                        </Trigger>
                        <!--鼠标按下时的样式-->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="SkyBlue"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <!--鼠标禁用时的样式-->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#EEEEEE"/>
                            <Setter Property="Foreground" Value="#AAAAAA"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>