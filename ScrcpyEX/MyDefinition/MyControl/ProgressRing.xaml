<UserControl x:Class="ScrcpyEX.MyDefinition.MyControl.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
             mc:Ignorable="d" 
             d:DesignHeight="80" d:DesignWidth="80">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- 自定义旋转圆环 -->
            <Ellipse x:Name="elp"
                     Width="40" 
                     Height="40" 
                     Stroke="DodgerBlue" 
                     StrokeThickness="4"
                     StrokeDashArray="2 8" 
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="Compose">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="0" To="-30" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <TextBlock x:Name="tbkDesc" Text="加载中..." Foreground="DodgerBlue" FontFamily="幼圆" FontWeight="ExtraBold" Margin="0,10,0,0" FontSize="14"/>
        </StackPanel>
    </Grid>
</UserControl>
