<UserControl x:Class="ScrcpyEX.MyDefinition.MyControl.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="500" 
             Loaded="UserControl_Loaded" IsVisibleChanged="UserControl_IsVisibleChanged">

    <UserControl.Resources>
        <Style x:Key="tbkStyle" TargetType="TextBlock" >
            <Setter Property="Foreground" Value="DodgerBlue"/>
            <Setter Property="FontFamily" Value="幼圆"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- 自定义旋转圆环 -->
            <Ellipse x:Name="elp"
                     Width="40" 
                     Height="40" 
                     Stroke="DodgerBlue" 
                     StrokeThickness="4"
                     StrokeDashArray="2 8" 
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform />
                </Ellipse.RenderTransform>
                <!--
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <Trigger Property="Visibility" Value="Visible">
                                <Trigger.EnterActions>
                                    <BeginStoryboard HandoffBehavior="Compose">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                             From="0" To="-30" Duration="0:0:1.5"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>-->
                
                <Ellipse.Resources>
                    <Storyboard x:Key="RotateAnim" RepeatBehavior="Forever">
                        <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset" From="0" To="-30" Duration="0:0:1.5"/>
                    </Storyboard>
                </Ellipse.Resources>
            </Ellipse>
            
            <TextBlock x:Name="tbkDesc" Text="加载中..." Style="{StaticResource tbkStyle}"  Margin="0,10,0,0"/>
            <TextBlock x:Name="tbkTxt1" Style="{StaticResource tbkStyle}"/>
            <TextBlock x:Name="tbkTxt2" Style="{StaticResource tbkStyle}"/>
            <TextBlock x:Name="tbkTxt3" Style="{StaticResource tbkStyle}"/>

        </StackPanel>
    </Grid>
</UserControl>
