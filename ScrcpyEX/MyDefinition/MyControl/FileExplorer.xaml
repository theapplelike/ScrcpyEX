<UserControl x:Class="ScrcpyEX.MyDefinition.MyControl.FileExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
             xmlns:converter="clr-namespace:ScrcpyEX.MyDefinition.MyConverter"
             mc:Ignorable="d" 
             x:Name="root"
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">

    <UserControl.Resources>
        <converter:FileToIconConverter x:Key="FileToIconConverter"/>
        <converter:FileSizeConverter x:Key="FileSizeConverter"/>
        <converter:SortArrowConverter x:Key="SortArrowConverter"/>
        <SolidColorBrush x:Key="Scb1" Color="red" Opacity="0.1"/>

        <!--ListView的内容控件的列头样式-->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border x:Name="border" BorderThickness="0,0,1,0" BorderBrush="Black" Margin="-0,0,0,0">
                            <Grid SnapsToDevicePixels="True" Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SortCmd, ElementName=root}"
                                                  CommandParameter="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid.InputBindings>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="HeaderContent"
                                                  Margin="4,4"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                                <!--<TextBlock Text="&#xe70d;" 
                                       Margin="0,0,4,0"
                                       Grid.Column="1" 
                                       Style="{StaticResource txtIcon}"/>-->
                                <!--指示升降序的箭头-->
                                <Path x:Name="SortArrow"
                                      Grid.Column="1"
                                      Width="8" 
                                      Height="6"
                                      Margin="4,0,4,0"
                                      Stretch="Fill"
                                      Fill="Gray">
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                            <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="SortColumn" ElementName="root"/>
                                            <Binding Path="SortDirection" ElementName="root"/>
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>

                                <!-- 调整列宽的Thumb和边框线重合 -->
                                <Thumb x:Name="PART_HeaderGripper"
                                       Grid.Column="2"
                                       Width="5"                          
                                       Cursor="SizeWE"
                                       HorizontalAlignment="Right"
                                       Background="Transparent"
                                       Margin="0,0,-3,0">
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <!-- 设置Thumb的颜色 -->
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>

                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 触发器：当角色是 Padding 或 Floating 时，隐藏右边框 -->
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="border" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="Role" Value="Floating">
                                <Setter TargetName="border" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,5" BorderThickness="1" BorderBrush="Black" CornerRadius="16" Padding="5,0,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnBack" Click="BtnBack_Click" Content="&#xf0b0;" Style="{StaticResource NaviBtn}"/>
                    <Button x:Name="btnFwrd" Click="BtnFwrd_Click" Content="&#xf0af;" Style="{StaticResource NaviBtn}"/>
                    <Button x:Name="btnGoUp" Click="BtnGoUp_Click" Style="{StaticResource NaviBtn}">
                        <TextBlock Style="{StaticResource txtIcon}" Text="&#xf0ad;">
                            <TextBlock.RenderTransform>
                                <!--向上箭头有偏移，这里进行修正-->
                                <TranslateTransform X="1.2" Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Border Width="2" Background="LightGray" Margin="2,0,4,0"/>
                </StackPanel>

                <ScrollViewer Grid.Column="1" 
                              x:Name="scv"
                              Margin="0,0,15,0"
                              Focusable="False"
                              CanContentScroll="True"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="Scv_PreviewMouseWheel">
                    <ItemsControl ItemsSource="{Binding Bis, ElementName=root}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Cursor="Hand">
                                    <Button x:Name="btnNavi" 
                                            Content="{Binding Name}" 
                                            Click="BtnNavi_Click"
                                            Style="{StaticResource NaviItemBtn}"/>
                                    <TextBlock Text=" / " Visibility="{Binding IsLast}" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

            </Grid>
        </Border>

        <ListView x:Name="lstAndroid" 
                  ItemsSource="{Binding DirView, ElementName=root}" 
                  Grid.Row="1"
                  d:ItemsSource="{d:SampleData ItemCount=5}">

            <ListView.Resources>
                <!--<Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource CleanColumnHeaderStyle}" />-->
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="gvcName">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Name">名称</GridViewColumnHeader>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid PreviewMouseUp="ChildGrid_PreviewMouseUp">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource txtIcon}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource FileToIconConverter}">
                                                <Binding Path="IsDirectory"/>
                                                <Binding Path="Extension"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="5,0" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextDecorations" Value="None"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid.ToolTip>
                                        <TextBlock Text="{Binding Name}" />
                                    </Grid.ToolTip>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="gvcSize">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Size">大小</GridViewColumnHeader>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="gvcTime">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Time">修改时间</GridViewColumnHeader>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

    </Grid>
</UserControl>
