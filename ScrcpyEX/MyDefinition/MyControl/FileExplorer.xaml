<UserControl x:Class="ScrcpyEX.MyDefinition.MyControl.FileExplorer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
             xmlns:mcl="clr-namespace:MyControlLibrary.Controls;assembly=MyControlLibrary"
             xmlns:ctrl="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
             xmlns:converter="clr-namespace:ScrcpyEX.MyDefinition.MyConverter"
             mc:Ignorable="d" 
             x:Name="root" d:DesignHeight="450" d:DesignWidth="800" 
             Loaded="Root_Loaded" Unloaded="Root_Unloaded">

    <UserControl.Resources>
        <converter:FileSizeConverter x:Key="FileSizeConverter"/>
        <converter:SortArrowConverter x:Key="SortArrowConverter"/>
        <converter:FileToIconConverter x:Key="FileToIconConverter"/>
        <SolidColorBrush x:Key="Scb1" Color="White" Opacity="0.01"/>

        <!-- MenuItem项的标题样式：看起来像静态文本，无交互 -->
        <Style x:Key="ContextMenuHeaderStyle" TargetType="MenuItem">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Background="WhiteSmoke" Padding="8,4">
                            <TextBlock Text="{TemplateBinding Header}" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                       FontSize="12"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--ListView的内容控件的列头样式-->
        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border x:Name="border" BorderThickness="0,0,1,0" BorderBrush="Black">
                            <Grid SnapsToDevicePixels="True" Background="Transparent">
                                <Grid.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding SortCmd, ElementName=root}"
                                                  CommandParameter="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Grid.InputBindings>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="HeaderContent"
                                                  Margin="6,4"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>

                                <!--指示升降序的箭头-->
                                <Path x:Name="SortArrow"
                                      Grid.Column="1"
                                      Width="8" 
                                      Height="6"
                                      Margin="0,0,6,0"
                                      Stretch="Fill"
                                      Fill="Gray">
                                    <Path.Data>
                                        <MultiBinding Converter="{StaticResource SortArrowConverter}">
                                            <Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="SortColumn" ElementName="root"/>
                                            <Binding Path="SortDirection" ElementName="root"/>
                                        </MultiBinding>
                                    </Path.Data>
                                </Path>

                                <!-- 调整列宽的Thumb和边框线重合 -->
                                <Thumb x:Name="PART_HeaderGripper"
                                       Grid.Column="2"
                                       Width="5"                          
                                       Cursor="SizeWE"
                                       HorizontalAlignment="Right"
                                       Background="Transparent"
                                       Margin="0,0,-3,0">
                                    <Thumb.Style>
                                        <Style TargetType="Thumb">
                                            <Setter Property="OverridesDefaultStyle" Value="True"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <!-- 设置Thumb的颜色 -->
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Thumb.Style>
                                </Thumb>

                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- 触发器：当角色是 Padding 时，隐藏右边框 -->
                            <Trigger Property="Role" Value="Padding">
                                <Setter TargetName="border" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <!-- 最后一列不显示右边框 -->
                            <Trigger Property="Tag" Value="Time">
                                <Setter TargetName="border" Property="BorderThickness" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThinScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>

            <!-- 默认：垂直 -->
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Bd" Background="#889E9E9E" CornerRadius="4" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#444444"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- 水平：换模板、换高宽、换命令方向 -->
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="8"/>
                    <Setter Property="MinHeight" Value="8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <!-- 水平方向 IsDirectionReversed 必须为 False -->
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb>
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Border x:Name="Bd" Background="#889E9E9E" CornerRadius="4" Margin="0,1"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#666666"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDragging" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#444444"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Border Margin="0,0,0,5" BorderThickness="1" BorderBrush="Black" CornerRadius="16" Padding="5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="btnBack" Click="BtnBack_Click" Content="&#xf0b0;" Style="{StaticResource NaviBtn}"/>
                    <Button x:Name="btnFwrd" Click="BtnFwrd_Click" Content="&#xf0af;" Style="{StaticResource NaviBtn}"/>
                    <Button x:Name="btnGoUp" Click="BtnGoUp_Click" Style="{StaticResource NaviBtn}">
                        <TextBlock Style="{StaticResource txtIcon}" Text="&#xf0ad;">
                            <TextBlock.RenderTransform>
                                <!--向上箭头有偏移，这里进行修正-->
                                <TranslateTransform X="1.2" Y="0"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Border Width="2" Background="LightGray" Margin="2,0,4,0"/>
                </StackPanel>

                <ScrollViewer x:Name="scv" 
                              Grid.Column="1" 
                              Margin="0,0,0,0"
                              Focusable="False"
                              CanContentScroll="True"
                              HorizontalScrollBarVisibility="Hidden" 
                              VerticalScrollBarVisibility="Disabled"
                              PreviewMouseWheel="Scv_PreviewMouseWheel">
                    <Grid>
                        <ItemsControl ItemsSource="{Binding Bis, ElementName=root}" 
                                      Background="{StaticResource Scb1}"
                                      MouseLeftButtonUp="ItemsControl_MouseLeftButtonUp">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Cursor="Hand">
                                        <Button x:Name="btnNavi" 
                                                Content="{Binding Name}" 
                                                Click="BtnNavi_Click"
                                                Style="{StaticResource NaviItemBtn}"/>
                                        <TextBlock Text=" / " Visibility="{Binding IsLast}" Foreground="Gray" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 地址栏输入框 -->
                        <TextBox x:Name="txtAddr"
                                 Visibility="Collapsed"
                                 Background="White"
                                 BorderThickness="0"
                                 FontSize="14"
                                 FontFamily="幼圆"
                                 VerticalContentAlignment="Center"
                                 KeyDown="TxtAddr_KeyDown"
                                 LostFocus="TxtAddr_LostFocus"/>
                    </Grid>
                </ScrollViewer>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding ShowGoRoot, ElementName=root}">
                    <Border Width="2" Background="LightGray" Margin="4,0,2,0"/>
                    <Button x:Name="btnRfsh" Click="BtnRfsh_Click" Content="&#xE72c;" Style="{StaticResource NaviBtn}" IsEnabled="True"/>
                    <Button x:Name="btnRoot" Click="BtnRoot_Click" Content="&#xEa8a;" Style="{StaticResource NaviBtn}" IsEnabled="True"/>
                </StackPanel>
                
            </Grid>
        </Border>

        <ListView x:Name="lstDir" 
                  Grid.Row="1"
                  ItemsSource="{Binding DirView, ElementName=root}" 
                  ContextMenuOpening="LstDir_ContextMenuOpening"
                  SelectionChanged="LstDir_SelectionChanged"
                  d:ItemsSource="{d:SampleData ItemCount=5}">

            <ListView.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}"/>
            </ListView.Resources>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.View>
                <GridView>
                    <GridViewColumn x:Name="gvcName">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Name">名称</GridViewColumnHeader>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ToolTipService.BetweenShowDelay="0" PreviewMouseLeftButtonUp="ChildGrid_PreviewMouseLeftButtonUp">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Style="{StaticResource txtIcon}">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource FileToIconConverter}">
                                                <Binding Path="IsDirectory"/>
                                                <Binding Path="Extension"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="5,0" Cursor="Hand">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextDecorations" Value="None"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="TextDecorations" Value="Underline"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock>
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="文件："/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Text" Value="目录："/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Name}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}, StringFormat='大小：{0}'}"/>
                                                <TextBlock Text="{Binding Time, StringFormat='修改时间：{0:yyyy-MM-dd HH:mm}'}"/>
                                            </StackPanel>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                    
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="gvcSize" Width="72">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Size">大小</GridViewColumnHeader>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Size, Converter={StaticResource FileSizeConverter}, ConverterParameter=emptyDir}"/>
                                    <Grid.ToolTip>
                                        <ToolTip>
                                            <TextBlock Text="{Binding Size, 
                                                             Converter={StaticResource FileSizeConverter},
                                                             ConverterParameter=full,
                                                             StringFormat='大小：{0}'}"/>
                                        </ToolTip>
                                    </Grid.ToolTip>
                                </Grid>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn x:Name="gvcTime" Width="114">
                        <GridViewColumn.Header>
                            <GridViewColumnHeader Tag="Time">修改时间</GridViewColumnHeader>
                        </GridViewColumn.Header>
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Time, StringFormat={}{0:yyyy-MM-dd HH:mm}}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                </GridView>
            </ListView.View>
        </ListView>

        <mcl:ProgressRing x:Name="prgLoad" Grid.Row="1" RingType="2" Visibility="Collapsed"/>
        <TextBlock x:Name="tbkErr" MouseUp="TbkErr_MouseUp" Grid.Row="1" 
                   Background="DarkKhaki" Foreground="GhostWhite" Visibility="Collapsed" 
                   Padding="5" HorizontalAlignment="Center" VerticalAlignment="Center" 
                   TextWrapping="Wrap" MaxWidth="400"/>

        <StatusBar Grid.Row="2" Margin="10,0,0,0" Background="Transparent">
            <StatusBar.ItemContainerStyle>
                <Style TargetType="StatusBarItem">
                    <Setter Property="Margin" Value="0,0,4,0"/>
                </Style>
            </StatusBar.ItemContainerStyle>

            <StatusBarItem>
                <TextBlock Text="{Binding DirView.Count, ElementName=root, StringFormat='共 {0} 项'}"/>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="tbkSelect"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</UserControl>
