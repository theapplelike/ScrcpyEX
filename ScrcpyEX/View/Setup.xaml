<Window x:Class="ScrcpyEX.View.Setup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        mc:Ignorable="d"
        Title="功能设置" Height="450" Width="600" d:DesignHeight="1000" 
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" Unloaded="Window_Unloaded">

    <Window.DataContext>
        <ViewModel:SetupVM/>
    </Window.DataContext>

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="65,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="55"/>
        </Style>
        <Style x:Key="tbkSmall" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#696969"/>
        </Style>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="Gainsboro"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style x:Key="stpBox" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="65,5"/>
            <Setter Property="Height" Value="55"/>
        </Style>
        <Style x:Key="tbkDesc" TargetType="TextBlock">
            <Setter Property="Width" Value="120"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="txt" TargetType="TextBox">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="200"/>
        </Style>
        <Style x:Key="Btn" TargetType="{x:Type Button}" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="FontFamily" Value="幼圆"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Background" Value="LightSteelBlue"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnScrcpy" Click="BtnScrcpy_Click" Style="{StaticResource BigBtn}" Grid.Row="0">
                        <Button.Content>
                            <Grid Width="{Binding ElementName=btnScrcpy,Path=ActualWidth}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="&#xec16;" Style="{StaticResource txtIcon}" Grid.Column="1" HorizontalAlignment="Left"/>
                                <TextBlock Text="投屏" Grid.Column="2"/>
                                <TextBlock Text="{Binding CharBtn1}" Style="{StaticResource txtIcon}" Grid.Column="2" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <StackPanel x:Name="stp1" Tag="{Binding Tag1,Mode=TwoWay}" Grid.Row="1">
                        <CheckBox IsChecked="{Binding Cfg.ScrcpySet.StayAwake}">
                            <StackPanel>
                                <TextBlock Text="保持唤醒"/>
                                <TextBlock Text="投屏时防止设备休眠，仅对有线连接有效" Style="{StaticResource tbkSmall}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border/>

                        <CheckBox IsChecked="{Binding Cfg.ScrcpySet.TurnScreenOff}">
                            <StackPanel>
                                <TextBlock Text="关闭屏幕"/>
                                <TextBlock Text="投屏时关闭设备屏幕，但不会进入休眠状态" Style="{StaticResource tbkSmall}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border/>

                        <CheckBox IsChecked="{Binding Cfg.ScrcpySet.ShowTouches}">
                            <StackPanel>
                                <TextBlock Text="显示触摸点"/>
                                <TextBlock Text="投屏时手指在触碰设备的地方显示触摸点" Style="{StaticResource tbkSmall}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border/>

                        <CheckBox IsChecked="{Binding Cfg.ScrcpySet.PowerOffOnClose}" Content="停止投屏时设备进入休眠"/>
                        <Border/>

                        <CheckBox IsChecked="{Binding Cfg.ScrcpySet.DisablScreensaver}" Content="设备投屏时电脑禁用屏幕保护"/>
                        <Border/>
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button x:Name="btnProg" Click="BtnProg_Click" Style="{StaticResource BigBtn}" Grid.Row="0">
                        <Button.Content>
                            <Grid Width="{Binding ElementName=btnScrcpy,Path=ActualWidth}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="25"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="25"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="&#xEC26;" Style="{StaticResource txtIcon}" Grid.Column="1" HorizontalAlignment="Left"/>
                                <TextBlock Text="程序" Grid.Column="2"/>
                                <TextBlock Text="{Binding CharBtn2}" Style="{StaticResource txtIcon}" Grid.Column="2" HorizontalAlignment="Right"/>
                            </Grid>
                        </Button.Content>
                    </Button>
                    <StackPanel x:Name="stp2" Tag="{Binding Tag2,Mode=TwoWay}" Grid.Row="1">
                        <CheckBox IsChecked="{Binding Cfg.IsUseLastSize}" Content="记住上一次退出时的位置和大小"/>
                        <Border/>

                        <CheckBox IsChecked="{Binding Cfg.IsKeepLandscape}">
                            <StackPanel>
                                <TextBlock Text="是否保持横屏"/>
                                <TextBlock Text="除了手动消除黑边，其他操作不会自动消除黑边" Style="{StaticResource tbkSmall}"/>
                            </StackPanel>
                        </CheckBox>
                        <Border/>

                        <CheckBox IsChecked="{Binding Cfg.IsCanResize}" Content="是否允许程序边缘调整大小"/>
                        <Border/>

                        <!--<StackPanel Style="{StaticResource stpBox}">
                <TextBlock Text="无线连接-IP地址" Style="{StaticResource tbkDesc}"/>
                <TextBox Text="{Binding Cfg.IP}" Style="{StaticResource txt}"/>
            </StackPanel>
            <Border/>

            <StackPanel Style="{StaticResource stpBox}">
                <TextBlock Text="无线连接-端口号" Style="{StaticResource tbkDesc}"/>
                <TextBox Text="{Binding Cfg.Port}" Style="{StaticResource txt}"/>
            </StackPanel>
            <Border/>-->
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>
        

        <Rectangle Grid.Row="1" Height="2" Fill="CornflowerBlue"/>
        
        <StackPanel Grid.Row="2" Orientation="Horizontal" FlowDirection="RightToLeft" Margin="10,10,20,10">
            <Button x:Name="btnExit" Click="BtnExit_Click" Content="关闭窗口" Style="{StaticResource Btn}"/>
        </StackPanel>

    </Grid>
</Window>
