<Window x:Class="ScrcpyEX.View.ShowImg"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        Title="图片详情" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    
    <Grid Background="WhiteSmoke">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <UniformGrid x:Name="ufg" Rows="1">
            <Image x:Name="img" Margin="5"/>
        </UniformGrid>
        
        <TextBlock x:Name="tbkDesc" Text="脚本截图的起始坐标基于主程序左窗口上角，比对截图的起始坐标基于Scrcpy窗口左上角。" Grid.Row="1" Margin="10" HorizontalAlignment="Center"/>
        <TextBlock x:Name="tbkParam" Text="起始坐标" Grid.Row="2" Margin="10" HorizontalAlignment="Center"/>
    </Grid>
</Window>
