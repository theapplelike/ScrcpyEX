<Window x:Class="ScrcpyEX.View.SelectDevice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        x:Name="root"
        Title="选择连接设备" Height="450" Width="600" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.DataContext>
        <ViewModel:SelectDeviceVM/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="LstBtn" TargetType="Button" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="40"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="请选择要连接的设备" FontFamily="幼圆" FontSize="35" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        <ListBox x:Name="lst" ItemsSource="{Binding Infos}" SelectionChanged="Lst_SelectionChanged" Grid.Row="1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Top">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="LightSteelBlue" BorderThickness="2" CornerRadius="10">
                        <Grid Margin="0,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="tbkEdit" Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center"/>
                            <Button x:Name="btnEdit" 
                                    Click="BtnEdit_Click" 
                                    Grid.Column="1" 
                                    Content="{Binding DataContext.BtnChar, ElementName=root}" 
                                    Style="{StaticResource LstBtn}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</Window>
