<Window x:Class="ScrcpyEX.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        xmlns:wfh="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        Title="MainWindow" Height="700" Width="800" 
        Loaded="Window_Loaded" Closed="Window_Closed">
    
    <StackPanel>
        <DockPanel Height="40" Background="AliceBlue" VerticalAlignment="Top">
            <Button Name="BtnWired" Content="有线" Width="40" Click="BtnWired_Click"/>

            <Button DockPanel.Dock="Right" Content="X" Width="40"/>
            <Button DockPanel.Dock="Right" Content="D" Width="40" HorizontalAlignment="Right" />
        </DockPanel>

        <Border BorderBrush="Red" BorderThickness="3" Width="750" Height="350">
            <Grid Name="gShow" >
                <WindowsFormsHost >
                    <wf:Panel x:Name="pnlShow"></wf:Panel>
                </WindowsFormsHost>
            </Grid>
            
        </Border>
    </StackPanel>
</Window>
