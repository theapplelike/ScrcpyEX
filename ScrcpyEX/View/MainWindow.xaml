<Window x:Class="ScrcpyEX.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        xmlns:wfI="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel" 
        xmlns:mycontrol="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
        Title="MainWindow" Height="488" Width="970" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closed="Window_Closed" SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged" Activated="Window_Activated" Deactivated="Window_Deactivated"
        LocationChanged="Window_LocationChanged">

    <Window.DataContext>
        <ViewModel:MainWindowVM/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" UseAeroCaptionButtons="False" NonClientFrameEdges="Left" ResizeBorderThickness="5"></WindowChrome>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="thisBtn" TargetType="Button" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="AliceBlue"/>
        </Style>
        <Style x:Key="ItemBtn" TargetType="Button">
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Height" Value="30"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="sep" TargetType="Rectangle">
            <Setter Property="Fill" Value="Gray"/>
            <Setter Property="Width" Value="2"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2,0"/>
        </Style>
        <SolidColorBrush x:Key="Scb1" Color="#D5EBFB" Opacity="0.6"/>
        <SolidColorBrush x:Key="Scb2" Color="#5B9DF0" Opacity="0.5"/>
    </Window.Resources>

    <Grid x:Name="gMain" Background="LightSteelBlue">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!--程序通用的鼠标提示-->
        <mycontrol:TimePopup x:Name="pop" PopupAnimation="Fade" Placement="Mouse">
            <Border MinHeight="10" MinWidth="10" CornerRadius="5" BorderThickness="2" BorderBrush="{StaticResource Scb2}" Background="{StaticResource Scb1}" Margin="5">
                <TextBlock Text="提示文本" Padding="10"/>
            </Border>
        </mycontrol:TimePopup>

        <!--主界面使用的居中提示-->
        <mycontrol:TimePopup x:Name="popMid" PopupAnimation="Slide" Placement="Center" PlacementTarget="{Binding ElementName=gMenu}" Opened="PopMid_Opened">
            <Border MinHeight="10" MinWidth="10" CornerRadius="10" BorderThickness="4" BorderBrush="{StaticResource Scb2}" Background="{StaticResource Scb1}" Margin="5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="Gray"/>
                </Border.Effect>
                <TextBlock FontSize="20" Padding="10" Foreground="#3F6897"/>
            </Border>
        </mycontrol:TimePopup>

        <!--位置和大小的菜单-->
        <Popup x:Name="popSize" PopupAnimation="Fade" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=btnLocOpt}">
            <Border BorderBrush="Gainsboro" BorderThickness="2" MinWidth="200">
                <StackPanel Background="White">
                    <TextBlock Text="{Binding Resolution}" Background="White" Padding="5"/>
                    <TextBlock Text="{Binding Scaling}" Background="White" Padding="5"/>
                    <UniformGrid Rows="2" Columns="2" Margin="0,3" Background="lavender">
                        <RadioButton x:Name="rdoLoc1" Content="↖左上" Margin="0,5,0,2"/>
                        <RadioButton x:Name="rdoLoc2" Content="↗右上" Margin="0,5,0,2"/>
                        <RadioButton x:Name="rdoLoc3" Content="↙左下" Margin="0,2,0,5"/>
                        <RadioButton x:Name="rdoLoc4" Content="↘右下" Margin="0,2,0,5"/>
                    </UniformGrid>

                    <Button x:Name="btnQuarterLoc"  Click="BtnQuarterLoc_Click"  Style="{StaticResource ItemBtn}" Content="¼电脑屏幕尺寸并定位"/>
                    <Button x:Name="btnOriginalLoc" Click="BtnOriginalLoc_Click" Style="{StaticResource ItemBtn}" Content="▣默认原始尺寸并定位"/>

                    <UniformGrid Rows="1" Columns="2">
                        <Button x:Name="btnReduce"  Click="BtnReduce_Click"  Style="{StaticResource ItemBtn}" Content="缩小尺寸"/>
                        <Button x:Name="btnAmplify" Click="BtnAmplify_Click" Style="{StaticResource ItemBtn}" Content="放大尺寸"/>
                    </UniformGrid>
                    <!--<Button Style="{StaticResource ItemBtn}" Content="⌂居中"/>-->
                </StackPanel>
            </Border>
        </Popup>
        
        <!--功能菜单-->
        <Popup x:Name="popFunc" PopupAnimation="Fade" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PlacementTarget="{Binding ElementName=btnFuncOpt}">
            <Border BorderBrush="Gainsboro" BorderThickness="2" MinWidth="200">
                <StackPanel Background="White">
                    <TextBlock Text="功能菜单" Background="AliceBlue" Padding="10"/>
                    <Button x:Name="btnSet" Click="BtnSet_Click" Style="{StaticResource ItemBtn}" Content="功能设置"/>
                    <Button x:Name="btnScGotFocus" Click="BtnScGotFocus_Click" Style="{StaticResource ItemBtn}" Content="激活投屏输入(F1)"/>

                    <UniformGrid Rows="1" Columns="2">
                        <Button x:Name="btnRemoveBlack" Click="BtnRemoveBlack_Click" Style="{StaticResource ItemBtn}" Content="消除投屏黑边"/>
                        <Button x:Name="btnOpenWireless" Click="BtnOpenWireless_Click" Style="{StaticResource ItemBtn}" Content="开启无线调试" ToolTip="将USB连接电脑的设备开启无线调试，开启后可以进行无线连接，设备和电脑需要处于一个网络中。"/>
                    </UniformGrid>

                    <UniformGrid Rows="1" Columns="3">
                        <Button x:Name="btnMappingEdit" Click="BtnMappingEdit_Click" Style="{StaticResource ItemBtn}" Content="映射编辑"/>
                        <Button x:Name="btnMappingBack" Click="BtnMappingBack_Click" Style="{StaticResource ItemBtn}" Content="取消修改" IsEnabled="False"/>
                        <Button x:Name="btnMappingAdd"  Click="BtnMappingAdd_Click"  Style="{StaticResource ItemBtn}" Content="添加映射" IsEnabled="False"/>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Popup>

        <!--放置右侧按钮的溢出悬停菜单-->
        <mycontrol:HoverPopup x:Name="popSysOpt" PlacementTarget="{Binding ElementName=btnClosePrg}">
        </mycontrol:HoverPopup>

        <!--Scrcpy功能选项菜单-->
        <mycontrol:HoverPopup x:Name="popScOpt">
        </mycontrol:HoverPopup>

        <!--自定义菜单栏-->
        <Grid x:Name="gMenu" Background="AliceBlue" MouseLeftButtonDown="GMenu_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <ToolBarTray>
                <ToolBar ToolBarTray.IsLocked="True">

                    <DockPanel x:Name="dcpScMain">
                        <Button x:Name="btnWired" Click="BtnWired_Click" Style="{StaticResource thisBtn}" Content="&#xF0B9;" ToolTip="有线连接"/>
                        <Button x:Name="btnWirel" Click="BtnWirel_Click" Style="{StaticResource thisBtn}" Content="&#xe93e;" ToolTip="无线连接"/>
                        <Button x:Name="btnStop"  Click="BtnStop_Click"  Style="{StaticResource thisBtn}" Content="&#xECCB;" ToolTip="停止投屏"/>
                    </DockPanel>
                    <Rectangle Style="{StaticResource sep}"/><!---->

                    <mycontrol:IconButton x:Name="btnLocOpt"  Click="BtnLocOpt_Click"  MainIcon="&#xe78a;" CornerIcon="&#xE7bc;" ToolTip="位置与大小选项"/>
                    <mycontrol:IconButton x:Name="btnFuncOpt" Click="BtnFuncOpt_Click" MainIcon="&#xebd2;" CornerIcon="&#xE7bc;" ToolTip="功能菜单"/>
                    <Rectangle Style="{StaticResource sep}"/>

                    <mycontrol:IconButton x:Name="btnRecManage" Click="BtnRecManage_Click" MainIcon="&#xea40;" CornerIcon="&#xE712;" ToolTip="脚本管理"/>
                    <Button x:Name="btnRecScr" Click="BtnRecScr_Click" Content="&#xe9a1;" Style="{StaticResource thisBtn}" ToolTip="录制脚本"/>

                    <Button x:Name="btnTest" Style="{StaticResource thisBtn}" Content="&#xf133;" Click="BtnTest_Click" PreviewMouseDoubleClick="BtnTest_PreviewMouseDoubleClick"/>
                    <Border x:Name="bdRec" HorizontalAlignment="Right" BorderBrush="SteelBlue" BorderThickness="4">
                        <DockPanel>
                            <Button x:Name="btnImgCompare" Click="BtnImgCompare_Click" Style="{StaticResource thisBtn}" Content="&#xf58c;" Foreground="SteelBlue" Height="22" ToolTip="查看脚本比对图像"/>
                            <DockPanel x:Name="dplTip" Height="22">
                                <TextBlock FontSize="20" Width="4" Background="SteelBlue"/>
                                <TextBlock Text="{Binding CycleNum}" VerticalAlignment="Center" FontSize="16" Margin="2,0,0,0"/>
                                <TextBlock Text="次⊱⊰" VerticalAlignment="Center" FontSize="16"/>
                                <TextBlock Text="{Binding Running}" VerticalAlignment="Center" FontSize="16"/>
                                <TextBlock Text="秒" VerticalAlignment="Center" FontSize="16" Margin="0,0,2,0"/>
                                <TextBlock FontSize="20" Width="4" Background="SteelBlue"/>
                            </DockPanel>
                            <Button x:Name="btnRecStop" Click="BtnRecStop_Click" Style="{StaticResource thisBtn}" Content="&#xe769;" Foreground="SteelBlue" Height="22" ToolTip="停止脚本/录制"/>
                        </DockPanel>
                    </Border>
                    
                </ToolBar>
            </ToolBarTray>

            <StackPanel x:Name="stpRightMenu" Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                <Button x:Name="btnClosePrg" Click="BtnClosePrg_Click" Style="{StaticResource thisBtn}" Content="&#xe711;"/>
                <Button x:Name="btnMaximize" Click="BtnMaximize_Click" Style="{StaticResource thisBtn}" Content="&#xe922;"/>
                <Button x:Name="btnMinimize" Click="BtnMinimize_Click" Style="{StaticResource thisBtn}" Content="&#xe73c;"/>
            </StackPanel>
            
        </Grid>

        <!--自定义菜单栏-->
        <!--<DockPanel x:Name="dpl" Background="AliceBlue" MouseLeftButtonDown="Dpl_MouseLeftButtonDown">
