<Window x:Class="ScrcpyEX.View.RecManage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        Title="RecManage" Height="400" Width="600" x:Name="root"
        WindowStartupLocation="CenterScreen" SizeToContent="Width"
        Loaded="Window_Loaded" Closed="Root_Closed">

    <Window.DataContext>
        <ViewModel:RecManageVM/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="LstBtn" TargetType="Button" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="40"/>
        </Style>
        <Style x:Key="Btn" TargetType="{x:Type Button}" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="FontFamily" Value="幼圆"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="LightSteelBlue" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="脚本列表：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ListBox x:Name="lst" ItemsSource="{Binding RecInfos}" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightSteelBlue" BorderThickness="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="tbkEdit" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                                <TextBox x:Name="txtEdit" Text="{Binding Name}" Visibility="Hidden" VerticalAlignment="Center" Margin="10,0"/>
                                <Button x:Name="btnEdit" Click="BtnEdit_Click" Grid.Column="1" Content="&#xe8ac;" Style="{StaticResource LstBtn}"/>
                                <TextBlock Text="|" FontSize="20" Grid.Column="2" HorizontalAlignment="Center"/>

                                <Button x:Name="btnPlay" Click="BtnPlay_Click" CommandParameter="{Binding}" Grid.Column="3" Content="&#xec57;" Style="{StaticResource LstBtn}"/>
                                <Button x:Name="btnSet" Command="{Binding DataContext.SetParamCommand,ElementName=root}" CommandParameter="{Binding}" Grid.Column="4" Content="&#xe713;" Style="{StaticResource LstBtn}"/>
                                <Button x:Name="btnDel" Command="{Binding DataContext.DelRecCommand,ElementName=root}" CommandParameter="{Binding}" Grid.Column="5" Content="&#xe74d;" Style="{StaticResource LstBtn}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Text="详细信息：" VerticalAlignment="Center" Margin="10,0,0,0"/>

            <DataGrid Grid.Row="1" ItemsSource="{Binding PointDt}" AutoGenerateColumns="False" Margin="0,0,0,8" CanUserSortColumns="False" CanUserAddRows="False" SelectionUnit="Cell">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="延时（秒）" Binding="{Binding LastTime}" Width="*" />
                    <DataGridTextColumn Header="坐标点X" Binding="{Binding XAxis}" Width="*" />
                    <DataGridTextColumn Header="坐标点Y" Binding="{Binding YAxis}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnSave" Command="{Binding DataContext.SaveCommand,ElementName=root}" Content="保存" Style="{StaticResource Btn}"/>
                <Button x:Name="btnCanel" Command="{Binding DataContext.CanelCommand,ElementName=root}" Content="取消" Style="{StaticResource Btn}" Grid.Column="1"/>
            </Grid>
        </Grid>
        
    </Grid>
</Window>
