<Window x:Class="ScrcpyEX.View.RecManage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        Title="脚本管理" Height="450" Width="640" x:Name="root"
        WindowStartupLocation="CenterScreen" SizeToContent="Width"
        Loaded="Window_Loaded" Closed="Root_Closed">

    <Window.DataContext>
        <ViewModel:RecManageVM/>
    </Window.DataContext>

    <Window.Resources>
        <Style x:Key="LstBtn" TargetType="Button" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Width" Value="40"/>
        </Style>
        <Style x:Key="Btn" TargetType="{x:Type Button}" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="FontFamily" Value="幼圆"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="LightSteelBlue" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="脚本列表（有黑边时执行脚本会导致错位）：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ListBox x:Name="lst" ItemsSource="{Binding RecInfos}" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Visibility="Hidden">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightSteelBlue" BorderThickness="0,0,0,2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="155" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="tbkEdit" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="10,0"/>
                                <TextBox x:Name="txtEdit" Text="{Binding Name}" Visibility="Hidden" VerticalAlignment="Center" Margin="10,0"/>
                                <Button x:Name="btnEdit" Click="BtnEdit_Click" Grid.Column="1" Content="&#xe8ac;" Style="{StaticResource LstBtn}"/>
                                <TextBlock Text="|" FontSize="20" Grid.Column="2" HorizontalAlignment="Center"/>

                                <Button x:Name="btnPlay" Click="BtnPlay_Click" CommandParameter="{Binding}" Grid.Column="3" Content="&#xec57;" Style="{StaticResource LstBtn}"/>
                                <Button x:Name="btnSet" Click="BtnSet_Click" CommandParameter="{Binding}" Grid.Column="4" Content="&#xe713;" Style="{StaticResource LstBtn}"/>
                                <Button x:Name="btnDel" Command="{Binding DataContext.DelRecCommand,ElementName=root}" CommandParameter="{Binding}" Grid.Column="5" Content="&#xe74d;" Style="{StaticResource LstBtn}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Image x:Name="img1"  Grid.Row="1"/>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>
            <TextBlock Text="详细信息：" VerticalAlignment="Center" Margin="10,0,0,0"/>

            <DataGrid Grid.Row="1" ItemsSource="{Binding PointDt}" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserAddRows="False" SelectionUnit="Cell">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="延时（秒）" Binding="{Binding LastTime}" Width="*" />
                    <DataGridTextColumn Header="坐标点X" Binding="{Binding XAxis}" Width="*" />
                    <DataGridTextColumn Header="坐标点Y" Binding="{Binding YAxis}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="2" Margin="0,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="20"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="执行循环" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <RadioButton x:Name="rdoLimited" Grid.Row="0" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="执行" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCycleNum" Width="40" Margin="5,0"/>
                        <TextBlock Text="次" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="rdoHandStop" Grid.Row="1" Grid.Column="1" Content="手动停止" />

                <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="LightSteelBlue" BorderThickness="0,0,0,2" Margin="0,0,0,2"/>

                <TextBlock Text="循环条件" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <RadioButton x:Name="rdoTime" Grid.Row="3" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="时间间隔" VerticalAlignment="Center"/>
                        <TextBox x:Name="txtCycleInterval" Width="40" Margin="5,0"/>
                        <TextBlock Text="次" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="rdoImage" Grid.Row="4" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="局部图片" VerticalAlignment="Center"/>
                        <Image x:Name="img" Width="40" Margin="5,0" MouseLeftButtonDown="Img_MouseLeftButtonDown"/>
                        <Button x:Name="btnScreenshot" Click="BtnScreenshot_Click" Content="截图" Style="{StaticResource Btn}"/>
                    </StackPanel>
                </RadioButton>

                <!--<StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="1">
                    <TextBox x:Name="txtCycleInterval" Width="40" Margin="0,0,5,0" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock Text="秒" VerticalAlignment="Center"/>
                    <Button x:Name="btnScreenshot" Click="BtnScreenshot_Click" Content="截图" Style="{StaticResource Btn}"/>
                </StackPanel>-->
            </Grid>
            
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="btnSave" Click="BtnSave_Click" Content="保存" Style="{StaticResource Btn}"/>
                <Button x:Name="btnCanel" Click="BtnCanel_Click" Content="取消" Style="{StaticResource Btn}" Grid.Column="1"/>
            </Grid>
        </Grid>
        
    </Grid>
</Window>
