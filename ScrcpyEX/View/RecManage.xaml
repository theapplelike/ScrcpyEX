<Window x:Class="ScrcpyEX.View.RecManage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        Title="RecManage" Height="450" Width="800" 
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <Window.DataContext>
        <ViewModel:RecManageVM/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
        </Grid.ColumnDefinitions>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="tbk1" Text="脚本列表：" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <ListBox x:Name="lst" ItemsSource="{Binding RecInfos}" Grid.Row="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="tbkEdit" Text="{Binding Name}" MaxWidth="100" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBox x:Name="txtEdit" Text="{Binding Name}" Visibility="Hidden"/>
                            <Button x:Name="btnEdit" Click="BtnEdit_Click" Grid.Column="2" Content="编辑"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        
    </Grid>
</Window>
