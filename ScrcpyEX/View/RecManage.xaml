<Window x:Class="ScrcpyEX.View.RecManage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        xmlns:converter="clr-namespace:ScrcpyEX.MyDefinition.MyConverter"
        mc:Ignorable="d"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        Title="脚本管理" Height="450" Width="640" x:Name="root" 
        AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        WindowStartupLocation="CenterScreen" SizeToContent="Width"
        Loaded="Window_Loaded" Closed="Root_Closed">

    <Window.DataContext>
        <ViewModel:RecManageVM/>
    </Window.DataContext>

    <Window.Resources>
        <SolidColorBrush x:Key="Scb1" Color="#5B9DF0" Opacity="0.25"/>
        <converter:IsScriptGroupConverter x:Key="IsScriptTypeConverter"/>
        
        <Style x:Key="LstBtn" TargetType="Button" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="40"/>
        </Style>
        <Style x:Key="Btn" TargetType="{x:Type Button}" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="FontFamily" Value="幼圆"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="LightSteelBlue"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="{x:Type ListBoxItem}">
            <Setter Property="Focusable" Value="False"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <EventSetter Event="GotFocus" Handler="TextBox_GotFocus"/>
        </Style>

        <DrawingBrush x:Key="StripeBrush" TileMode="Tile" Viewport="0,0,30,30" ViewportUnits="Absolute" Viewbox="0,0,30,30" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="{StaticResource Scb1}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry>
                            <PathFigure StartPoint="0,30" IsClosed="True">
                                <LineSegment Point="0,15"/>
                                <QuadraticBezierSegment Point1="7.5,5" Point2="15,15"/>
                                <QuadraticBezierSegment Point1="22.5,25" Point2="30,15"/>
                                <LineSegment Point="30,30"/>
                            </PathFigure>
                        </PathGeometry>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <!--设置圆角需要窗体背景色为透明，背景色需要在Border设置-->
    <Border BorderThickness="3" BorderBrush="#5B9DF0" CornerRadius="10" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <Grid MouseLeftButtonDown="G_MouseLeftButtonDown" Width="100" Height="20" Background="Beige" Grid.ColumnSpan="2" VerticalAlignment="Top"/>

            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="脚本列表（有黑边时执行脚本会导致错位）：" Margin="10,0,0,0"/>
                <ListBox x:Name="lst" ItemsSource="{Binding ScriptItems}" Grid.Row="1" SelectionChanged="Lst_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" AllowDrop="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ListBoxItem_PreviewMouseLeftButtonDown"/>
                            <EventSetter Event="MouseMove" Handler="ListBoxItem_MouseMove"/>
                            <EventSetter Event="DragEnter" Handler="ListBoxItem_DragEnter"/>
                            <EventSetter Event="Drop" Handler="ListBoxItem_Drop"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="borderRoot" BorderBrush="LightSteelBlue" BorderThickness="0,0,0,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="155"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="tbkEdit" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="10,0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="txtEdit" Text="{Binding Name}" Visibility="Hidden" VerticalAlignment="Center" Margin="10,0"/>

                                    <Button x:Name="btnEdit" Click="BtnEdit_Click" Grid.Column="1" Content="&#xe8ac;" Style="{StaticResource LstBtn}"/>
                                    <TextBlock Text="|" FontSize="20" Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

                                    <Button x:Name="btnAct" Click="BtnAct_Click" CommandParameter="{Binding}" Grid.Column="3" Content="&#xec57;" Style="{StaticResource LstBtn}"/>
                                    <Button x:Name="btnSet" Click="BtnSet_Click" CommandParameter="{Binding}" Grid.Column="4" Content="&#xe713;" Style="{StaticResource LstBtn}"/>
                                    <Button x:Name="btnDel" Click="BtnDel_Click" CommandParameter="{Binding}" Grid.Column="5" Content="&#xe74d;" Style="{StaticResource LstBtn}"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=., Converter={StaticResource IsScriptTypeConverter}}" Value="True">
                                    <Setter TargetName="borderRoot" Property="Background" Value="{StaticResource StripeBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="30"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="stpExeMode" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="执行模式"/>
                    <RadioButton x:Name="rdoInTurn" Content="顺序轮流" GroupName="mode" Margin="5,0"/>
                    <RadioButton x:Name="rdoKeepOn" Content="成功继续" GroupName="mode" Margin="0,0,5,0"/>
                    <Button x:Name="btnHelp" Click="BtnHelp_Click" Content="&#xe9ce;" Style="{StaticResource MenuBtn}" Width="32"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="详细信息" />
                    <!--显示组脚本中的脚本列表-->
                    <ComboBox x:Name="cmbMultipleScript" SelectionChanged="CmbMultipleScript_SelectionChanged" Margin="5,2" Width="140"/>
                </StackPanel>

                <DataGrid x:Name="dgPoint" Grid.Row="2" AutoGenerateColumns="False" CanUserSortColumns="False" CanUserAddRows="False" SelectionUnit="Cell">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="延时（秒）" Binding="{Binding LastTime}" Width="*"/>
                        <DataGridTextColumn Header="坐标点X" Binding="{Binding XAxis}" Width="*"/>
                        <DataGridTextColumn Header="坐标点Y" Binding="{Binding YAxis}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="4"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="循环次数" HorizontalAlignment="Center"/>
                    <RadioButton x:Name="rdoLimited" Grid.Row="0" Grid.Column="1" GroupName="num">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="指定执行"/>
                            <TextBox x:Name="txtCycleNum" Width="40" Margin="5,0"/>
                            <TextBlock Text="次"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="rdoHandStop" Grid.Row="1" Grid.Column="1" Content="手动停止" GroupName="num"/>

                    <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="LightSteelBlue" BorderThickness="0,0,0,2" Margin="0,0,0,2"/>

                    <TextBlock Text="循环条件" Grid.Row="3" Grid.Column="0" HorizontalAlignment="Center"/>
                    <RadioButton x:Name="rdoTime" Grid.Row="3" Grid.Column="1" GroupName="cond">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="时间间隔"/>
                            <TextBox x:Name="txtCycleInterval" Width="40" Margin="5,0"/>
                            <TextBlock Text="秒"/>
                        </StackPanel>
                    </RadioButton>
                    <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="1">
                        <RadioButton x:Name="rdoImage" Checked="RdoImage_Checked" Unchecked="RdoImage_Unchecked" Content="局部图片" GroupName="cond"/>
                        <Grid Width="40" Margin="5,0" Background="Gainsboro">
                            <Image x:Name="img" MouseLeftButtonDown="Img_MouseLeftButtonDown"/>
                        </Grid>
                        <Button x:Name="btnScreenshot" Click="BtnScreenshot_Click" Content="截图" Style="{StaticResource Btn}" Width="60"/>
                    </StackPanel>

                    <Grid x:Name="gSuboption" Grid.Row="5" Grid.Column="1" Margin="18,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Row="0" ToolTip="图像比对后相似度在指定值及以上时进行下一次循环。">
                            <TextBox x:Name="txtSimilarity" Width="40"/>
                            <TextBlock Text="% 相似度"/>
                        </StackPanel>
                        <CheckBox x:Name="chkAdaptive" Content="使用自适应间隔" Grid.Row="1" VerticalAlignment="Center" ToolTip="图像比对默认5秒一次，如果开启自适应间隔，第二次循环起，图像比对时间为上一次总间隔的90%，一次之后恢复为5秒。"/>
                    </Grid>
                </Grid>
            
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="btnFouce" Width="10" Height="10"/>
                    <Button x:Name="btnSave" Click="BtnSave_Click" Content="保存" Style="{StaticResource Btn}"/>
                    <Button x:Name="btnExit" Click="BtnExit_Click" Content="关闭" Style="{StaticResource Btn}" Grid.Column="1"/>
                </Grid>
            </Grid>
        
        </Grid>
    </Border>
    
</Window>
