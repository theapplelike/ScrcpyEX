<Window x:Class="ScrcpyEX.View.DataSync"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        xmlns:ViewModel="clr-namespace:ScrcpyEX.ViewModel"
        xmlns:ctrl="clr-namespace:ScrcpyEX.MyDefinition.MyControl"
        mc:Ignorable="d"
        Title="DataSync" Height="450" Width="800" WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <ViewModel:DataSyncVM/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <ctrl:FileExplorer Grid.Column="0" DirService="{Binding LclService}"/>
        <ctrl:FileExplorer Grid.Column="1" DirService="{Binding AdbService}"/>
    </Grid>
</Window>
