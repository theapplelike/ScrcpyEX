<Window x:Class="ScrcpyEX.View.GroupMode"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScrcpyEX.View"
        mc:Ignorable="d"
        Title="组脚本设置" Height="200" Width="300" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="70"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="thisBtn" TargetType="{x:Type Button}" BasedOn="{StaticResource MenuBtn}">
            <Setter Property="FontFamily" Value="幼圆"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Width" Value="80"/>
            <Setter Property="Background" Value="LightSteelBlue"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <TextBlock Text="执行模式："/>
            <RadioButton x:Name="rdoInTurn" Checked="RdoInTurn_Checked" Content="顺序轮流" GroupName="mode" Margin="5,0" ToolTip="A->B->A->B"/>
            <RadioButton x:Name="rdoKeepOn" Checked="RdoKeepOn_Checked" Content="成功继续" GroupName="mode" Margin="0,0,20,0" ToolTip="[A-A...]成功->[B-B...]成功"/>
            <Button x:Name="btnHelp" Click="BtnHelp_Click" Content="&#xe9ce;" Style="{StaticResource MenuBtn}" Width="32"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,20">
            <TextBlock Text="计数模式："/>
            <RadioButton x:Name="rdoAlone" Content="单脚本" GroupName="count" Margin="5,0" ToolTip="组脚本中每单个脚本执行后计数加一"/>
            <RadioButton x:Name="rdoGroup" Content="组脚本" GroupName="count" ToolTip="完整执行所有脚本后计数加一"/>
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="btnSave" Click="BtnSave_Click" Content="保存" Style="{StaticResource thisBtn}"/>
            <Button x:Name="btnExit" Click="BtnExit_Click" Content="取消" Style="{StaticResource thisBtn}" Grid.Column="1"/>
        </Grid>

    </Grid>
</Window>
